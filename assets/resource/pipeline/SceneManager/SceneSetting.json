{
    "__ScenePrivateMenuListEnterMenuSetting": {
        "desc": "从菜单总列表点击左上角齿轮进入设置",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InMenuList",
                    {
                        "recognition": {
                            "type": "TemplateMatch",
                            "param": {
                                "roi": [
                                    140,
                                    28,
                                    110,
                                    90
                                ],
                                "template": [
                                    "SceneManager/Setting/MenuGear.png"
                                ],
                                "green_mask": true,
                                "threshold": 0.7
                            }
                        }
                    }
                ],
                "box_index": 1
            }
        },
        "pre_delay": 0,
        "action": {
            "type": "Click"
        },
        "post_delay": 0,
        "rate_limit": 0,
        "next": [
            "__ScenePrivateAnyEnterMenuSettingSuccess"
        ]
    },
    "__ScenePrivateAnyEnterMenuSettingSuccess": {
        "desc": "成功进入设置",
        "recognition": {
            "type": "And",
            "param": {
                "all_of": [
                    "InSetting"
                ]
            }
        },
        "pre_wait_freezes": {
            "time": 100,
            "target": [
                0,
                0,
                280,
                80
            ]
        },
        "pre_delay": 0,
        "post_delay": 0,
        "rate_limit": 0
    },
