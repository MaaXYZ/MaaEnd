{
    "__AutoEssenceRecoEssenceTriggerButton": {
        "desc": "寻找激发的大世界按钮（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    800,
                    450,
                    100,
                    180
                ],
                "template": "AutoEssence/EssenceTrigger.png",
                "green_mask": true,
                "order_by": "Score"
            }
        }
    },
    "__AutoEssenceRecoEssenceTriggerText": {
        "desc": "寻找激发的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceTriggerButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "激发", // 激发
                    "觸發", // 觸發
                    "Trigger", // Trigger
                    "トリガー" // トリガー
                ]
            }
        }
    },
    "AutoEssenceClickEssenceStartButtonText": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "WhiteConfirmButtonType1",
                "roi_offset": [
                    -100,
                    -25,
                    100,
                    50
                ],
                "expected": [
                    "开启挑战",
                    "開啟挑戰",
                    "Start",
                    "挑戦"
                ]
            }
        }
    },
    "__AutoEssenceRecoEssenceOngoing": {
        "desc": "寻找挑战进行中的状态（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    40,
                    260,
                    330
                ],
                "template": "AutoEssence/EssenceOngoing.png",
                "green_mask": true
            }
        }
    },
    "__AutoEssenceRecoEssenceObtainButton": {
        "desc": "寻找领取奖励的状态（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    780,
                    340,
                    170,
                    310
                ],
                "template": "AutoEssence/EssenceObtain.png",
                "green_mask": true,
                "threshold": 0.45,
                "order_by": "Score"
            }
        }
    },
    "__AutoEssenceRecoEssenceObtainText": {
        "desc": "寻找领取奖励的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceObtainButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "领取", // 领取奖励
                    "領取", // 領取獎勵
                    "Claim", // Claim Rewards
                    "報酬" // 報酬受取
                ]
            }
        }
    },
    "__AutoEssenceRecoEssenceDiscardText": {
        "desc": "寻找放弃领取奖励的文字（仅识别）",
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": "__AutoEssenceRecoEssenceObtainButton",
                "roi_offset": [
                    0,
                    0,
                    150,
                    0
                ],
                "expected": [
                    "放弃|重置", // 放弃奖励并重置
                    "放棄|重置", // 放棄獎勵並重置
                    "Abandon|Reset", // Abandon Rewards and Reset
                    "受取せず|にリセット" // 受取せずにリセット
                ]
            }
        }
    },
    "__AutoEssenceLowSpDialog": {
        "desc": "识别体力不足弹窗的图标（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    400,
                    210,
                    200,
                    210
                ],
                "template": "AutoEssence/SpDialog.png"
            }
        }
    },
    "__AutoEssenceLowSpDialogCloseButton": {
        "desc": "识别体力不足弹窗的按钮（仅识别）",
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1030,
                    90,
                    245,
                    200
                ],
                "template": "AutoEssence/SpDialogCloseButton.png"
            }
        }
    }
}
