{
    // 终点筛选调度节点：next 列表由 endpoint-filter-data.mjs 的终点映射表自动生成，
    // 新增终点只需往映射表加一行，无需手动改这里。
    "SeizeDeliveryJobsEndpointFilter": {
        "desc": "检查地图已打开后，按照地图区域筛选终点",
        "enabled": false,
        "recognition": "Or",
        "any_of": [
            "__SeizeDeliveryJobsRecoWulingDepotNode"
        ],
        "inverse": true, // 如果*不在*仓储管理页面时，视为地图已经打开
        "pre_delay": 0,
        "post_wait_freezes": 500,
        "post_delay": 0,
        "next": "${EndpointNodes}"
    }
}
